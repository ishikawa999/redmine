<% if @quick_access_items.any? %>
  <p class="quick-access-preview-heading">
    <%= l(:label_latest_quick_access_items, count: QuickAccessItem::PREVIEW_LIMIT) %>
  </p>
  <ul class="quick-access-preview-items">
    <% @quick_access_items.each do |item| %>
      <li class="quick-access-preview-item" data-quick-access-id="<%= item.id %>">
        <%= quick_access_target_link(item.target) %>
        <span class="quick-access-preview-project"><%= quick_access_project(item.target).name %></span>
        <span class="quick-access-preview-type">
          <%= quick_access_type_label(item.target) %>
          <%= quick_access_status_badge(item.target) %>
        </span>
      </li>
    <% end %>
    <li class="quick-access-preview-more">
      <%= link_to l(:label_view_all_quick_access_items), quick_access_items_path %>
    </li>
  </ul>
<% else %>
  <p class="nodata"><%= l(:label_no_quick_access_items) %></p>
<% end %>
